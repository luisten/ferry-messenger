// The project's base configuration (project.pbxproj), so every target inherits it.
// Your own values go in Local.xcconfig (gitignored): copy Local.example.xcconfig and fill it in. Without it the app
// still builds and runs in the simulator, as com.example.ferry-messenger.

FERRY_BUNDLE_PREFIX = com.example
DEVELOPMENT_TEAM =

// A release candidate's label, shown after the version in Accounts ("Ferry Messenger 1.7-RC1"). MARKETING_VERSION
// stays numbers only, as iOS requires. CI refuses it on main: empty it before merging.
FERRY_PRERELEASE =

// How the app was installed: the release workflow builds its .ipa with `ipa`, whose updates come through AltStore or
// SideStore; an App Store build is `appstore` (docs/APP-STORE.md). Empty: built from source, so Accounts checks for new
// versions and shows when the build stops opening.
FERRY_DISTRIBUTION =

#include? "Local.xcconfig"
